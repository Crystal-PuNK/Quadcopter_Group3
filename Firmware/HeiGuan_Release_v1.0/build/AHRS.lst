  50:./User/AHRS.c **** // AHRS algorithm update
  51:./User/AHRS.c **** 
  52:./User/AHRS.c **** void MahonyAHRSupdate(float gx, float gy, float gz, float ax, float ay, float az, float mx, float m
  53:./User/AHRS.c **** 	float recipNorm;
  54:./User/AHRS.c ****     float q0q0, q0q1, q0q2, q0q3, q1q1, q1q2, q1q3, q2q2, q2q3, q3q3;  
  55:./User/AHRS.c **** 	float hx, hy, bx, bz;
  56:./User/AHRS.c **** 	float halfvx, halfvy, halfvz, halfwx, halfwy, halfwz;
  57:./User/AHRS.c **** 	float halfex, halfey, halfez;
  58:./User/AHRS.c **** 	float qa, qb, qc;
  59:./User/AHRS.c **** 
  60:./User/AHRS.c **** 	// Use IMU algorithm if magnetometer measurement invalid (avoids NaN in magnetometer normalisation
  61:./User/AHRS.c **** 	if((mx == 0.0f) && (my == 0.0f) && (mz == 0.0f)) {
  62:./User/AHRS.c **** 		MahonyAHRSupdateIMU(gx, gy, gz, ax, ay, az);
  63:./User/AHRS.c **** 		return;
  64:./User/AHRS.c **** 	}
  65:./User/AHRS.c **** 
  66:./User/AHRS.c **** 	// Compute feedback only if accelerometer measurement valid (avoids NaN in accelerometer normalisa
  67:./User/AHRS.c **** 	if(!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
  68:./User/AHRS.c **** 
  69:./User/AHRS.c **** 		// Normalise accelerometer measurement
  70:./User/AHRS.c **** 		recipNorm = invSqrt(ax * ax + ay * ay + az * az);
  71:./User/AHRS.c **** 		ax *= recipNorm;
  72:./User/AHRS.c **** 		ay *= recipNorm;
  73:./User/AHRS.c **** 		az *= recipNorm;     
  74:./User/AHRS.c **** 
  75:./User/AHRS.c **** 		// Normalise magnetometer measurement
  76:./User/AHRS.c **** 		recipNorm = invSqrt(mx * mx + my * my + mz * mz);
  77:./User/AHRS.c **** 		mx *= recipNorm;
  78:./User/AHRS.c **** 		my *= recipNorm;
  79:./User/AHRS.c **** 		mz *= recipNorm;   
  80:./User/AHRS.c **** 
  81:./User/AHRS.c ****         // Auxiliary variables to avoid repeated arithmetic
  82:./User/AHRS.c ****         q0q0 = q0 * q0;
  83:./User/AHRS.c ****         q0q1 = q0 * q1;
  84:./User/AHRS.c ****         q0q2 = q0 * q2;
  85:./User/AHRS.c ****         q0q3 = q0 * q3;
  86:./User/AHRS.c ****         q1q1 = q1 * q1;
  87:./User/AHRS.c ****         q1q2 = q1 * q2;
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 3


  88:./User/AHRS.c ****         q1q3 = q1 * q3;
  89:./User/AHRS.c ****         q2q2 = q2 * q2;
  90:./User/AHRS.c ****         q2q3 = q2 * q3;
  91:./User/AHRS.c ****         q3q3 = q3 * q3;   
  92:./User/AHRS.c **** 
  93:./User/AHRS.c ****         // Reference direction of Earth's magnetic field
  94:./User/AHRS.c ****         hx = 2.0f * (mx * (0.5f - q2q2 - q3q3) + my * (q1q2 - q0q3) + mz * (q1q3 + q0q2));
  95:./User/AHRS.c ****         hy = 2.0f * (mx * (q1q2 + q0q3) + my * (0.5f - q1q1 - q3q3) + mz * (q2q3 - q0q1));
  96:./User/AHRS.c ****         bx = sqrt(hx * hx + hy * hy);
  97:./User/AHRS.c ****         bz = 2.0f * (mx * (q1q3 - q0q2) + my * (q2q3 + q0q1) + mz * (0.5f - q1q1 - q2q2));
  98:./User/AHRS.c **** 
  99:./User/AHRS.c **** 		// Estimated direction of gravity and magnetic field
 100:./User/AHRS.c **** 		halfvx = q1q3 - q0q2;
 101:./User/AHRS.c **** 		halfvy = q0q1 + q2q3;
 102:./User/AHRS.c **** 		halfvz = q0q0 - 0.5f + q3q3;
 103:./User/AHRS.c ****         halfwx = bx * (0.5f - q2q2 - q3q3) + bz * (q1q3 - q0q2);
 104:./User/AHRS.c ****         halfwy = bx * (q1q2 - q0q3) + bz * (q0q1 + q2q3);
 105:./User/AHRS.c ****         halfwz = bx * (q0q2 + q1q3) + bz * (0.5f - q1q1 - q2q2);  
 106:./User/AHRS.c **** 	
 107:./User/AHRS.c **** 		// Error is sum of cross product between estimated direction and measured direction of field vect
 108:./User/AHRS.c **** 		halfex = (ay * halfvz - az * halfvy) + (my * halfwz - mz * halfwy);
 109:./User/AHRS.c **** 		halfey = (az * halfvx - ax * halfvz) + (mz * halfwx - mx * halfwz);
 110:./User/AHRS.c **** 		halfez = (ax * halfvy - ay * halfvx) + (mx * halfwy - my * halfwx);
 111:./User/AHRS.c **** 
 112:./User/AHRS.c **** 		// Compute and apply integral feedback if enabled
 113:./User/AHRS.c **** 		if(twoKi > 0.0f) {
 114:./User/AHRS.c **** 			integralFBx += twoKi * halfex * deltaT;	// integral error scaled by Ki
 115:./User/AHRS.c **** 			integralFBy += twoKi * halfey * deltaT;
 116:./User/AHRS.c **** 			integralFBz += twoKi * halfez * deltaT;
 117:./User/AHRS.c **** 			gx += integralFBx;	// apply integral feedback
 118:./User/AHRS.c **** 			gy += integralFBy;
 119:./User/AHRS.c **** 			gz += integralFBz;
 120:./User/AHRS.c **** 		}
 121:./User/AHRS.c **** 		else {
 122:./User/AHRS.c **** 			integralFBx = 0.0f;	// prevent integral windup
 123:./User/AHRS.c **** 			integralFBy = 0.0f;
 124:./User/AHRS.c **** 			integralFBz = 0.0f;
 125:./User/AHRS.c **** 		}
 126:./User/AHRS.c **** 
 127:./User/AHRS.c **** 		// Apply proportional feedback
 128:./User/AHRS.c **** 		gx += twoKp * halfex;
 129:./User/AHRS.c **** 		gy += twoKp * halfey;
 130:./User/AHRS.c **** 		gz += twoKp * halfez;
 131:./User/AHRS.c **** 	}
 132:./User/AHRS.c **** 	
 133:./User/AHRS.c **** 	// Integrate rate of change of quaternion
 134:./User/AHRS.c **** 	gx *= (0.5f * deltaT);		// pre-multiply common factors
 135:./User/AHRS.c **** 	gy *= (0.5f * deltaT);
 136:./User/AHRS.c **** 	gz *= (0.5f * deltaT);
 137:./User/AHRS.c **** 	qa = q0;
 138:./User/AHRS.c **** 	qb = q1;
 139:./User/AHRS.c **** 	qc = q2;
 140:./User/AHRS.c **** 	q0 += (-qb * gx - qc * gy - q3 * gz);
 141:./User/AHRS.c **** 	q1 += (qa * gx + qc * gz - q3 * gy);
 142:./User/AHRS.c **** 	q2 += (qa * gy - qb * gz + q3 * gx);
 143:./User/AHRS.c **** 	q3 += (qa * gz + qb * gy - qc * gx); 
 144:./User/AHRS.c **** 	
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 4


 145:./User/AHRS.c **** 	// Normalise quaternion
 146:./User/AHRS.c **** 	recipNorm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
 147:./User/AHRS.c **** 	q0 *= recipNorm;
 148:./User/AHRS.c **** 	q1 *= recipNorm;
 149:./User/AHRS.c **** 	q2 *= recipNorm;
 150:./User/AHRS.c **** 	q3 *= recipNorm;
 151:./User/AHRS.c **** }
 152:./User/AHRS.c **** 
 153:./User/AHRS.c **** //-------------------------------------------------------------------------------------------------
 154:./User/AHRS.c **** // IMU algorithm update
 155:./User/AHRS.c **** 
 156:./User/AHRS.c **** void MahonyAHRSupdateIMU(float gx, float gy, float gz, float ax, float ay, float az) {
 157:./User/AHRS.c **** 	float recipNorm;
 158:./User/AHRS.c **** 	float halfvx, halfvy, halfvz;
 159:./User/AHRS.c **** 	float halfex, halfey, halfez;
 160:./User/AHRS.c **** 	float qa, qb, qc;
 161:./User/AHRS.c **** 
 162:./User/AHRS.c **** 	// Compute feedback only if accelerometer measurement valid (avoids NaN in accelerometer normalisa
 163:./User/AHRS.c **** 	if(!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
 164:./User/AHRS.c **** 
 165:./User/AHRS.c **** 		// Normalise accelerometer measurement
 166:./User/AHRS.c **** 		recipNorm = invSqrt(ax * ax + ay * ay + az * az);
 167:./User/AHRS.c **** 		ax *= recipNorm;
 168:./User/AHRS.c **** 		ay *= recipNorm;
 169:./User/AHRS.c **** 		az *= recipNorm;        
 170:./User/AHRS.c **** 
 171:./User/AHRS.c **** 		// Estimated direction of gravity and vector perpendicular to magnetic flux
 172:./User/AHRS.c **** 		halfvx = q1 * q3 - q0 * q2;
 173:./User/AHRS.c **** 		halfvy = q0 * q1 + q2 * q3;
 174:./User/AHRS.c **** 		halfvz = q0 * q0 - 0.5f + q3 * q3;
 175:./User/AHRS.c **** 	
 176:./User/AHRS.c **** 		// Error is sum of cross product between estimated and measured direction of gravity
 177:./User/AHRS.c **** 		halfex = (ay * halfvz - az * halfvy);
 178:./User/AHRS.c **** 		halfey = (az * halfvx - ax * halfvz);
 179:./User/AHRS.c **** 		halfez = (ax * halfvy - ay * halfvx);
 180:./User/AHRS.c **** 
 181:./User/AHRS.c **** 		// Compute and apply integral feedback if enabled
 182:./User/AHRS.c **** 		if(twoKi > 0.0f) {
 183:./User/AHRS.c **** 			integralFBx += twoKi * halfex * deltaT;	// integral error scaled by Ki
 184:./User/AHRS.c **** 			integralFBy += twoKi * halfey * deltaT;
 185:./User/AHRS.c **** 			integralFBz += twoKi * halfez * deltaT;
 186:./User/AHRS.c **** 			gx += integralFBx;	// apply integral feedback
 187:./User/AHRS.c **** 			gy += integralFBy;
 188:./User/AHRS.c **** 			gz += integralFBz;
 189:./User/AHRS.c **** 		}
 190:./User/AHRS.c **** 		else {
 191:./User/AHRS.c **** 			integralFBx = 0.0f;	// prevent integral windup
 192:./User/AHRS.c **** 			integralFBy = 0.0f;
 193:./User/AHRS.c **** 			integralFBz = 0.0f;
 194:./User/AHRS.c **** 		}
 195:./User/AHRS.c **** 
 196:./User/AHRS.c **** 		// Apply proportional feedback
 197:./User/AHRS.c **** 		gx += twoKp * halfex;
 198:./User/AHRS.c **** 		gy += twoKp * halfey;
 199:./User/AHRS.c **** 		gz += twoKp * halfez;
 200:./User/AHRS.c **** 	}
 201:./User/AHRS.c **** 	
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 5


 202:./User/AHRS.c **** 	// Integrate rate of change of quaternion
 203:./User/AHRS.c **** 	gx *= (0.5f * deltaT);		// pre-multiply common factors
 204:./User/AHRS.c **** 	gy *= (0.5f * deltaT);
 205:./User/AHRS.c **** 	gz *= (0.5f * deltaT);
 206:./User/AHRS.c **** 	qa = q0;
 207:./User/AHRS.c **** 	qb = q1;
 208:./User/AHRS.c **** 	qc = q2;
 209:./User/AHRS.c **** 	q0 += (-qb * gx - qc * gy - q3 * gz);
 210:./User/AHRS.c **** 	q1 += (qa * gx + qc * gz - q3 * gy);
 211:./User/AHRS.c **** 	q2 += (qa * gy - qb * gz + q3 * gx);
 212:./User/AHRS.c **** 	q3 += (qa * gz + qb * gy - qc * gx); 
 213:./User/AHRS.c **** 	
 214:./User/AHRS.c **** 	// Normalise quaternion
 215:./User/AHRS.c **** 	recipNorm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
 216:./User/AHRS.c **** 	q0 *= recipNorm;
 217:./User/AHRS.c **** 	q1 *= recipNorm;
 218:./User/AHRS.c **** 	q2 *= recipNorm;
 219:./User/AHRS.c **** 	q3 *= recipNorm;
 220:./User/AHRS.c **** }
 221:./User/AHRS.c **** 
 222:./User/AHRS.c **** // ==================================================================================
 223:./User/AHRS.c **** // 描述:
 224:./User/AHRS.c **** // 必须定义'halfT '为周期的一半，以及滤波器的参数Kp和Ki
 225:./User/AHRS.c **** // 四元数'q0', 'q1', 'q2', 'q3'定义为全局变量
 226:./User/AHRS.c **** // 需要在每一个采样周期调用'IMUupdate()'函数
 227:./User/AHRS.c **** // 陀螺仪数据单位是弧度/秒，加速度计、磁力计的单位无关重要，因为会�
 228:./User/AHRS.c **** // ==================================================================================
 229:./User/AHRS.c **** static float Kp = 2.0f; // 比例常数
 230:./User/AHRS.c **** static float Ki = 0.005f; // 积分常数
 231:./User/AHRS.c **** static float halfT = 0.0005f; //采样周期的一半，实际halfT由定时器求出
 232:./User/AHRS.c **** // static float T = 0.001f; // 采样周期为1ms
 233:./User/AHRS.c **** static float exInt = 0, eyInt = 0, ezInt = 0; // 误差积分累计值
 234:./User/AHRS.c **** 
 235:./User/AHRS.c **** 
 236:./User/AHRS.c **** // ==================================================================================
 237:./User/AHRS.c **** // 函数原型：void Attitude_Update(float gx, float gy, float gz, float ax, float ay, float az, 
 238:./User/AHRS.c **** // 功        能：互补滤波进行姿态解算
 239:./User/AHRS.c **** // 输        入：陀螺仪数据及加速度计数据及磁力计数据
 240:./User/AHRS.c **** // ==================================================================================
 241:./User/AHRS.c **** void Attitude_Update(float gx, float gy, float gz, float ax, float ay, float az, float mx, float my
 242:./User/AHRS.c **** {
 243:./User/AHRS.c ****     float norm;
 244:./User/AHRS.c ****     float hx, hy, hz, bz, by;
 245:./User/AHRS.c ****     float vx, vy, vz, wx, wy, wz;
 246:./User/AHRS.c ****     float ex, ey, ez;
 247:./User/AHRS.c ****     float q0_last, q1_last, q2_last, q3_last;
 248:./User/AHRS.c **** 
 249:./User/AHRS.c ****     //空间换时间，提高效率
 250:./User/AHRS.c ****     float q0q0 = q0 * q0;
 251:./User/AHRS.c ****     float q0q1 = q0 * q1;
 252:./User/AHRS.c ****     float q0q2 = q0 * q2;
 253:./User/AHRS.c ****     float q0q3 = q0 * q3;
 254:./User/AHRS.c ****     float q1q1 = q1 * q1;
 255:./User/AHRS.c ****     float q1q2 = q1 * q2;
 256:./User/AHRS.c ****     float q1q3 = q1 * q3;
 257:./User/AHRS.c ****     float q2q2 = q2 * q2;
 258:./User/AHRS.c ****     float q2q3 = q2 * q3;
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 6


 259:./User/AHRS.c ****     float q3q3 = q3 * q3;
 260:./User/AHRS.c **** 
 261:./User/AHRS.c ****     //加速度计归一化，这就是为什么之前只要陀螺仪数据进行单位转换
 262:./User/AHRS.c ****     norm = invSqrt(ax * ax + ay * ay + az * az);
 263:./User/AHRS.c ****     ax = ax * norm;
 264:./User/AHRS.c ****     ay = ay * norm;
 265:./User/AHRS.c ****     az = az * norm;
 266:./User/AHRS.c ****     //计算上一时刻机体坐标系下加速度坐标
 267:./User/AHRS.c ****     vx = 2 * (q1q3 - q0q2);
 268:./User/AHRS.c ****     vy = 2 * (q0q1 + q2q3);
 269:./User/AHRS.c ****     vz = q0q0 - q1q1 - q2q2 + q3q3;
 270:./User/AHRS.c **** 
 271:./User/AHRS.c ****     //磁力计数据归一化
 272:./User/AHRS.c ****     norm = invSqrt(mx * mx + my * my + mz * mz);
 273:./User/AHRS.c ****     mx = mx * norm;
 274:./User/AHRS.c ****     my = my * norm;
 275:./User/AHRS.c ****     mz = mz * norm;
 276:./User/AHRS.c ****     //计算地理坐标系下磁力坐标（地理南北极）
 277:./User/AHRS.c ****     hx = 2 * mx * (0.5f - q2q2 - q3q3) + 2 * my * (q1q2 - q0q3) + 2 * mz * (q1q3 + q0q2);
 278:./User/AHRS.c ****     hy = 2 * mx * (q1q2 + q0q3) + 2 * my * (0.5f - q1q1 - q3q3) + 2 * mz * (q2q3 - q0q1);
 279:./User/AHRS.c ****     hz = 2 * mx * (q1q3 - q0q2) + 2 * my * (q2q3 + q0q1) + 2 * mz * (0.5f - q1q1 - q2q2);
 280:./User/AHRS.c ****     //（地磁南北极）因为地磁南北极与地理南北极有偏差
 281:./User/AHRS.c ****     //bx=0;
 282:./User/AHRS.c ****     by = sqrtf((hx * hx) + (hy * hy));
 283:./User/AHRS.c ****     bz = hz;
 284:./User/AHRS.c ****     //磁力转换回机体坐标系坐标
 285:./User/AHRS.c ****     wx = 2 * by * (q1q2 + q0q3) + 2 * bz * (q1q3 - q0q2);
 286:./User/AHRS.c ****     wy = 2 * by * (0.5f - q1q1 - q3q3) + 2 * bz * (q0q1 + q2q3);
 287:./User/AHRS.c ****     wz = 2 * by * (q2q3 - q0q1) + 2 * bz * (0.5f - q1q1 - q2q2);
 288:./User/AHRS.c **** 
 289:./User/AHRS.c ****     //误差计算（加速度和磁场强度一起）
 290:./User/AHRS.c ****     ex = (ay * vz - az * vy) + (my * wz - mz * wy);
 291:./User/AHRS.c ****     ey = (az * vx - ax * vz) + (mz * wx - mx * wz);
 292:./User/AHRS.c ****     ez = (ax * vy - ay * vx) + (mx * wy - my * wx);
 293:./User/AHRS.c **** 
 294:./User/AHRS.c ****     //由定时器获取采样周期的一半
 295:./User/AHRS.c ****     halfT = deltaT / 2.0f;
 296:./User/AHRS.c **** 
 297:./User/AHRS.c ****     //pi运算
 298:./User/AHRS.c ****     if (ex != 0.0f && ey != 0.0f && ez != 0.0f) {
 299:./User/AHRS.c ****         // 误差积分
 300:./User/AHRS.c ****         exInt += ex * Ki * halfT;
 301:./User/AHRS.c ****         eyInt += ey * Ki * halfT;
 302:./User/AHRS.c ****         ezInt += ez * Ki * halfT;
 303:./User/AHRS.c **** 
 304:./User/AHRS.c ****         // 角速度补偿
 305:./User/AHRS.c ****         gx = gx + Kp * ex + exInt;
 306:./User/AHRS.c ****         gy = gy + Kp * ey + eyInt;
 307:./User/AHRS.c ****         gz = gz + Kp * ez + ezInt;
 308:./User/AHRS.c ****     }
 309:./User/AHRS.c **** 
 310:./User/AHRS.c ****     // 保存四元数
 311:./User/AHRS.c ****     q0_last = q0;
 312:./User/AHRS.c ****     q1_last = q1;
 313:./User/AHRS.c ****     q2_last = q2;
 314:./User/AHRS.c ****     q3_last = q3;
 315:./User/AHRS.c ****     // 积分增量运算
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 7


 316:./User/AHRS.c ****     q0 = q0_last + (-q1_last * gx - q2_last * gy - q3_last * gz) * halfT;
 317:./User/AHRS.c ****     q1 = q1_last + (q0_last * gx + q2_last * gz - q3_last * gy) * halfT;
 318:./User/AHRS.c ****     q2 = q2_last + (q0_last * gy - q1_last * gz + q3_last * gx) * halfT;
 319:./User/AHRS.c ****     q3 = q3_last + (q0_last * gz + q1_last * gy - q2_last * gx) * halfT;
 320:./User/AHRS.c **** 
 321:./User/AHRS.c ****     // 归一化四元数
 322:./User/AHRS.c ****     norm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
 323:./User/AHRS.c ****     q0 = q0 * norm; //w
 324:./User/AHRS.c ****     q1 = q1 * norm; //x
 325:./User/AHRS.c ****     q2 = q2 * norm; //y
 326:./User/AHRS.c ****     q3 = q3 * norm; //z
 327:./User/AHRS.c **** }
 328:./User/AHRS.c **** 
 329:./User/AHRS.c **** //-------------------------------------------------------------------------------------------------
 330:./User/AHRS.c **** // Fast inverse square-root
 331:./User/AHRS.c **** // See: http://en.wikipedia.org/wiki/Fast_inverse_square_root
 332:./User/AHRS.c **** 
