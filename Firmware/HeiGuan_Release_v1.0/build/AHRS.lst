  24:./User/AHRS.c **** // #define sampleFreq	512.0f			// sample frequency in Hz
  25:./User/AHRS.c **** extern volatile float deltaT;
  26:./User/AHRS.c **** #define twoKpDef	(2.0f * 2.0f)	// 2 * proportional gain
  27:./User/AHRS.c **** #define twoKiDef	(2.0f * 0.005f)	// 2 * integral gain
  28:./User/AHRS.c **** 
  29:./User/AHRS.c **** //-------------------------------------------------------------------------------------------------
  30:./User/AHRS.c **** // Variable definitions
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc6rF8H0.s 			page 2


  31:./User/AHRS.c **** 
  32:./User/AHRS.c **** volatile float twoKp = twoKpDef;											// 2 * proportional gain (Kp)
  33:./User/AHRS.c **** volatile float twoKi = twoKiDef;											// 2 * integral gain (Ki)
  34:./User/AHRS.c **** extern volatile float q0, q1, q2, q3;				// quaternion of sensor frame relative to auxiliary frame
  35:./User/AHRS.c **** volatile float integralFBx = 0.0f,  integralFBy = 0.0f, integralFBz = 0.0f;	// integral error terms
  36:./User/AHRS.c **** 
  37:./User/AHRS.c **** const float PI = 3.1415926535897932384626433f;
  38:./User/AHRS.c **** const float RAD_TO_DEGREE = 180.0f / PI;
  39:./User/AHRS.c **** const float DEGREE_TO_RAD = PI / 180.0f;
