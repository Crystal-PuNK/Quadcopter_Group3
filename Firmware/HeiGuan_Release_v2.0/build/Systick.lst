  29              		.file 1 "./User/Systick.c"
   1:./User/Systick.c **** /*
   2:./User/Systick.c **** * 使用HSE时，设置系统时钟的步骤
   3:./User/Systick.c **** * 1、开启HSE ，并等待 HSE 稳定
   4:./User/Systick.c **** * 2、设置 AHB、APB2、APB1的预分频因子
   5:./User/Systick.c **** * 3、设置PLL的时钟来源
   6:./User/Systick.c **** *    设置VCO输入时钟 分频因子        m
   7:./User/Systick.c **** *    设置VCO输出时钟 倍频因子        n
   8:./User/Systick.c **** *    设置PLLCLK时钟分频因子          p
   9:./User/Systick.c **** *    设置OTG FS,SDIO,RNG时钟分频因子 q
  10:./User/Systick.c **** * 4、开启PLL，并等待PLL稳定
  11:./User/Systick.c **** * 5、把PLLCK切换为系统时钟SYSCLK
  12:./User/Systick.c **** * 6、读取时钟切换状态位，确保PLLCLK被选为系统时钟
  13:./User/Systick.c **** */
  14:./User/Systick.c **** 
  15:./User/Systick.c **** /*
  16:./User/Systick.c **** * m: VCO输入时钟 分频因子，取值2~63
  17:./User/Systick.c **** * n: VCO输出时钟 倍频因子，取值192~432
  18:./User/Systick.c **** * p: PLLCLK时钟分频因子  ，取值2，4，6，8
  19:./User/Systick.c **** * q: OTG FS,SDIO,RNG时钟分频因子，取值4~15
  20:./User/Systick.c **** * 函数调用举例，使用HSE设置时钟
  21:./User/Systick.c **** * SYSCLK=HCLK=168M,PCLK2=HCLK/2=84M,PCLK1=HCLK/4=42M
  22:./User/Systick.c **** * HSE_SetSysClock(25, 336, 2, 7);
  23:./User/Systick.c **** * HSE作为时钟来源，经过PLL倍频作为系统时钟，这是通常的做法
  24:./User/Systick.c **** 
  25:./User/Systick.c **** * 系统时钟超频到216M爽一下
  26:./User/Systick.c **** * HSE_SetSysClock(25, 432, 2, 9);
  27:./User/Systick.c **** */
  28:./User/Systick.c **** 
  29:./User/Systick.c **** #include "Systick.h"
