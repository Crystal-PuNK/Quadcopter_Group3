  34:./User/PID.c  **** const float OUTER_INT_MAX = 40.0f;      // 外环积分限幅，对应角度误差累积和
  35:./User/PID.c  **** const float INNER_INT_MAX = 40.0f;      // 内环积分限幅，对应角速度误差累积和
  36:./User/PID.c  **** const float PWM_OUT_MAX = 300.0f;       // PWM 输出限幅，300.0 对应 30% 的油门
  37:./User/PID.c  **** const float TAKEOFF_THROTTLE = 1450.0f; // 起飞油门，飞行时的油门应大于此值
  38:./User/PID.c  **** 
  39:./User/PID.c  **** // 对应 roll 内环、 roll 外环、 pitch 内环、 pitch 外环、 yaw 外环、 yaw 内环
  40:./User/PID.c  **** PID_t rollInner, rollOuter, pitchInner, pitchOuter, yawOuter, yawInner;
  41:./User/PID.c  **** // 期望的 roll, pitch, yaw 角速度和油门（即遥控器发出的信号）
  42:./User/PID.c  **** float expRoll, expPitch, expYaw, expMode;
  43:./User/PID.c  **** int BLEcount = 0;
