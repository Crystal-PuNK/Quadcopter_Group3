  45:./User/PID.c  **** float pidRoll, pidPitch, pidYaw, pidThr;
  46:./User/PID.c  **** enum YAW_STATE {
  47:./User/PID.c  ****     YAW_STABLE, // 油门大于 TAKEOFF_THROTTLE 且期望角速度为 0，此时采用串级 PID �
  48:./User/PID.c  ****     YAW_ROTATE  // 否则为此状态，此时采用单环 PID 控制
  49:./User/PID.c  **** };
  50:./User/PID.c  **** enum FLY_STATE {
  51:./User/PID.c  ****     HOVER,      // 悬停
  52:./User/PID.c  ****     NOT_HOVER   // 非悬停
  53:./User/PID.c  **** };
  54:./User/PID.c  **** enum CH5_STATE { // 遥控器 CH5 三档开关状态，状态发生改变则进行机械校准
  55:./User/PID.c  ****     CH5_DOWN,
  56:./User/PID.c  ****     CH5_MIDDLE,
  57:./User/PID.c  ****     CH5_UP
  58:./User/PID.c  **** };
  59:./User/PID.c  **** enum YAW_STATE yawState = YAW_STABLE;
  60:./User/PID.c  **** enum FLY_STATE flyState = NOT_HOVER;
  61:./User/PID.c  **** enum CH5_STATE ch5State = CH5_DOWN;
