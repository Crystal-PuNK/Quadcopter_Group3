 454:./CORE/system_stm32f4xx.c **** /**
 455:./CORE/system_stm32f4xx.c ****    * @brief  Update SystemCoreClock variable according to Clock Register Values.
 456:./CORE/system_stm32f4xx.c ****   *         The SystemCoreClock variable contains the core clock (HCLK), it can
 457:./CORE/system_stm32f4xx.c ****   *         be used by the user application to setup the SysTick timer or configure
 458:./CORE/system_stm32f4xx.c ****   *         other parameters.
 459:./CORE/system_stm32f4xx.c ****   *           
 460:./CORE/system_stm32f4xx.c ****   * @note   Each time the core clock (HCLK) changes, this function must be called
 461:./CORE/system_stm32f4xx.c ****   *         to update SystemCoreClock variable value. Otherwise, any configuration
 462:./CORE/system_stm32f4xx.c ****   *         based on this variable will be incorrect.         
 463:./CORE/system_stm32f4xx.c ****   *     
 464:./CORE/system_stm32f4xx.c ****   * @note   - The system frequency computed by this function is not the real 
 465:./CORE/system_stm32f4xx.c ****   *           frequency in the chip. It is calculated based on the predefined 
 466:./CORE/system_stm32f4xx.c ****   *           constant and the selected clock source:
 467:./CORE/system_stm32f4xx.c ****   *             
 468:./CORE/system_stm32f4xx.c ****   *           - If SYSCLK source is HSI, SystemCoreClock will contain the HSI_VALUE(*)
 469:./CORE/system_stm32f4xx.c ****   *                                              
 470:./CORE/system_stm32f4xx.c ****   *           - If SYSCLK source is HSE, SystemCoreClock will contain the HSE_VALUE(**)
 471:./CORE/system_stm32f4xx.c ****   *                          
 472:./CORE/system_stm32f4xx.c ****   *           - If SYSCLK source is PLL, SystemCoreClock will contain the HSE_VALUE(**) 
 473:./CORE/system_stm32f4xx.c ****   *             or HSI_VALUE(*) multiplied/divided by the PLL factors.
 474:./CORE/system_stm32f4xx.c ****   *         
 475:./CORE/system_stm32f4xx.c ****   *         (*) HSI_VALUE is a constant defined in stm32f4xx.h file (default value
 476:./CORE/system_stm32f4xx.c ****   *             16 MHz) but the real value may vary depending on the variations
 477:./CORE/system_stm32f4xx.c ****   *             in voltage and temperature.   
 478:./CORE/system_stm32f4xx.c ****   *    
 479:./CORE/system_stm32f4xx.c ****   *         (**) HSE_VALUE is a constant defined in stm32f4xx.h file (default value
 480:./CORE/system_stm32f4xx.c ****   *              25 MHz), user has to ensure that HSE_VALUE is same as the real
 481:./CORE/system_stm32f4xx.c ****   *              frequency of the crystal used. Otherwise, this function may
 482:./CORE/system_stm32f4xx.c ****   *              have wrong result.
 483:./CORE/system_stm32f4xx.c ****   *                
 484:./CORE/system_stm32f4xx.c ****   *         - The result of this function could be not correct when using fractional
 485:./CORE/system_stm32f4xx.c ****   *           value for HSE crystal.
 486:./CORE/system_stm32f4xx.c ****   *     
 487:./CORE/system_stm32f4xx.c ****   * @param  None
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc2VwXPk.s 			page 10


 488:./CORE/system_stm32f4xx.c ****   * @retval None
 489:./CORE/system_stm32f4xx.c ****   */
 490:./CORE/system_stm32f4xx.c **** void SystemCoreClockUpdate(void)
 491:./CORE/system_stm32f4xx.c **** {
 492:./CORE/system_stm32f4xx.c ****   uint32_t tmp = 0, pllvco = 0, pllp = 2, pllsource = 0, pllm = 2;
 493:./CORE/system_stm32f4xx.c ****   
 494:./CORE/system_stm32f4xx.c ****   /* Get SYSCLK source -------------------------------------------------------*/
 495:./CORE/system_stm32f4xx.c ****   tmp = RCC->CFGR & RCC_CFGR_SWS;
 496:./CORE/system_stm32f4xx.c **** 
 497:./CORE/system_stm32f4xx.c ****   switch (tmp)
 498:./CORE/system_stm32f4xx.c ****   {
 499:./CORE/system_stm32f4xx.c ****     case 0x00:  /* HSI used as system clock source */
 500:./CORE/system_stm32f4xx.c ****       SystemCoreClock = HSI_VALUE;
 501:./CORE/system_stm32f4xx.c ****       break;
 502:./CORE/system_stm32f4xx.c ****     case 0x04:  /* HSE used as system clock source */
 503:./CORE/system_stm32f4xx.c ****       SystemCoreClock = HSE_VALUE;
 504:./CORE/system_stm32f4xx.c ****       break;
 505:./CORE/system_stm32f4xx.c ****     case 0x08:  /* PLL used as system clock source */
 506:./CORE/system_stm32f4xx.c ****        /* PLL_VCO = (HSE_VALUE or HSI_VALUE / PLL_M) * PLL_N
 507:./CORE/system_stm32f4xx.c ****          SYSCLK = PLL_VCO / PLL_P
 508:./CORE/system_stm32f4xx.c ****          */    
 509:./CORE/system_stm32f4xx.c ****       pllsource = (RCC->PLLCFGR & RCC_PLLCFGR_PLLSRC) >> 22;
 510:./CORE/system_stm32f4xx.c ****       pllm = RCC->PLLCFGR & RCC_PLLCFGR_PLLM;
 511:./CORE/system_stm32f4xx.c ****       
 512:./CORE/system_stm32f4xx.c **** #if defined (STM32F40_41xxx) || defined (STM32F427_437xx) || defined (STM32F429_439xx) || defined (
 513:./CORE/system_stm32f4xx.c ****       if (pllsource != 0)
 514:./CORE/system_stm32f4xx.c ****       {
 515:./CORE/system_stm32f4xx.c ****         /* HSE used as PLL clock source */
 516:./CORE/system_stm32f4xx.c ****         pllvco = (HSE_VALUE / pllm) * ((RCC->PLLCFGR & RCC_PLLCFGR_PLLN) >> 6);
 517:./CORE/system_stm32f4xx.c ****       }
 518:./CORE/system_stm32f4xx.c ****       else
 519:./CORE/system_stm32f4xx.c ****       {
 520:./CORE/system_stm32f4xx.c ****         /* HSI used as PLL clock source */
 521:./CORE/system_stm32f4xx.c ****         pllvco = (HSI_VALUE / pllm) * ((RCC->PLLCFGR & RCC_PLLCFGR_PLLN) >> 6);      
 522:./CORE/system_stm32f4xx.c ****       }
 523:./CORE/system_stm32f4xx.c **** #elif defined (STM32F411xE)
 524:./CORE/system_stm32f4xx.c **** #if defined (USE_HSE_BYPASS)
 525:./CORE/system_stm32f4xx.c ****       if (pllsource != 0)
 526:./CORE/system_stm32f4xx.c ****       {
 527:./CORE/system_stm32f4xx.c ****         /* HSE used as PLL clock source */
 528:./CORE/system_stm32f4xx.c ****         pllvco = (HSE_BYPASS_INPUT_FREQUENCY / pllm) * ((RCC->PLLCFGR & RCC_PLLCFGR_PLLN) >> 6);
 529:./CORE/system_stm32f4xx.c ****       }  
 530:./CORE/system_stm32f4xx.c **** #else  
 531:./CORE/system_stm32f4xx.c ****       if (pllsource == 0)
 532:./CORE/system_stm32f4xx.c ****       {
 533:./CORE/system_stm32f4xx.c ****         /* HSI used as PLL clock source */
 534:./CORE/system_stm32f4xx.c ****         pllvco = (HSI_VALUE / pllm) * ((RCC->PLLCFGR & RCC_PLLCFGR_PLLN) >> 6);
 535:./CORE/system_stm32f4xx.c ****       }  
 536:./CORE/system_stm32f4xx.c **** #endif /* USE_HSE_BYPASS */  
 537:./CORE/system_stm32f4xx.c **** #endif /* STM32F40_41xxx || STM32F427_437xx || STM32F429_439xx || STM32F401xx */  
 538:./CORE/system_stm32f4xx.c ****       pllp = (((RCC->PLLCFGR & RCC_PLLCFGR_PLLP) >>16) + 1 ) *2;
 539:./CORE/system_stm32f4xx.c ****       SystemCoreClock = pllvco/pllp;      
 540:./CORE/system_stm32f4xx.c ****       break;
 541:./CORE/system_stm32f4xx.c ****     default:
 542:./CORE/system_stm32f4xx.c ****       SystemCoreClock = HSI_VALUE;
 543:./CORE/system_stm32f4xx.c ****       break;
 544:./CORE/system_stm32f4xx.c ****   }
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc2VwXPk.s 			page 11


 545:./CORE/system_stm32f4xx.c ****   /* Compute HCLK frequency --------------------------------------------------*/
 546:./CORE/system_stm32f4xx.c ****   /* Get HCLK prescaler */
 547:./CORE/system_stm32f4xx.c ****   tmp = AHBPrescTable[((RCC->CFGR & RCC_CFGR_HPRE) >> 4)];
 548:./CORE/system_stm32f4xx.c ****   /* HCLK frequency */
 549:./CORE/system_stm32f4xx.c ****   SystemCoreClock >>= tmp;
 550:./CORE/system_stm32f4xx.c **** }
 551:./CORE/system_stm32f4xx.c **** 
 552:./CORE/system_stm32f4xx.c **** /**
 553:./CORE/system_stm32f4xx.c ****   * @brief  Configures the System clock source, PLL Multiplier and Divider factors, 
 554:./CORE/system_stm32f4xx.c ****   *         AHB/APBx prescalers and Flash settings
 555:./CORE/system_stm32f4xx.c ****   * @Note   This function should be called only once the RCC clock configuration  
 556:./CORE/system_stm32f4xx.c ****   *         is reset to the default reset state (done in SystemInit() function).   
 557:./CORE/system_stm32f4xx.c ****   * @param  None
 558:./CORE/system_stm32f4xx.c ****   * @retval None
