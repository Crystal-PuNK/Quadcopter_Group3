 405:./CORE/system_stm32f4xx.c **** /**
 406:./CORE/system_stm32f4xx.c ****   * @brief  Setup the microcontroller system
 407:./CORE/system_stm32f4xx.c ****   *         Initialize the Embedded Flash Interface, the PLL and update the 
 408:./CORE/system_stm32f4xx.c ****   *         SystemFrequency variable.
 409:./CORE/system_stm32f4xx.c ****   * @param  None
 410:./CORE/system_stm32f4xx.c ****   * @retval None
 411:./CORE/system_stm32f4xx.c ****   */
 412:./CORE/system_stm32f4xx.c **** void SystemInit(void)
 413:./CORE/system_stm32f4xx.c **** {
 414:./CORE/system_stm32f4xx.c ****   /* FPU settings ------------------------------------------------------------*/
 415:./CORE/system_stm32f4xx.c ****   #if (__FPU_PRESENT == 1) && (__FPU_USED == 1)
 416:./CORE/system_stm32f4xx.c ****     SCB->CPACR |= ((3UL << 10*2)|(3UL << 11*2));  /* set CP10 and CP11 Full Access */
 417:./CORE/system_stm32f4xx.c ****   #endif
 418:./CORE/system_stm32f4xx.c ****   /* Reset the RCC clock configuration to the default reset state ------------*/
 419:./CORE/system_stm32f4xx.c ****   /* Set HSION bit */
 420:./CORE/system_stm32f4xx.c ****   RCC->CR |= (uint32_t)0x00000001;
 421:./CORE/system_stm32f4xx.c **** 
 422:./CORE/system_stm32f4xx.c ****   /* Reset CFGR register */
 423:./CORE/system_stm32f4xx.c ****   RCC->CFGR = 0x00000000;
 424:./CORE/system_stm32f4xx.c **** 
 425:./CORE/system_stm32f4xx.c ****   /* Reset HSEON, CSSON and PLLON bits */
 426:./CORE/system_stm32f4xx.c ****   RCC->CR &= (uint32_t)0xFEF6FFFF;
 427:./CORE/system_stm32f4xx.c **** 
 428:./CORE/system_stm32f4xx.c ****   /* Reset PLLCFGR register */
 429:./CORE/system_stm32f4xx.c ****   RCC->PLLCFGR = 0x24003010;
 430:./CORE/system_stm32f4xx.c ****   //RCC->PLLCFGR = 0x24013008;
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//cc2VwXPk.s 			page 9


 431:./CORE/system_stm32f4xx.c **** 
 432:./CORE/system_stm32f4xx.c ****   /* Reset HSEBYP bit */
 433:./CORE/system_stm32f4xx.c ****   RCC->CR &= (uint32_t)0xFFFBFFFF;
 434:./CORE/system_stm32f4xx.c **** 
 435:./CORE/system_stm32f4xx.c ****   /* Disable all interrupts */
 436:./CORE/system_stm32f4xx.c ****   RCC->CIR = 0x00000000;
 437:./CORE/system_stm32f4xx.c **** 
 438:./CORE/system_stm32f4xx.c **** #if defined (DATA_IN_ExtSRAM) || defined (DATA_IN_ExtSDRAM)
 439:./CORE/system_stm32f4xx.c ****   SystemInit_ExtMemCtl(); 
 440:./CORE/system_stm32f4xx.c **** #endif /* DATA_IN_ExtSRAM || DATA_IN_ExtSDRAM */
 441:./CORE/system_stm32f4xx.c ****          
 442:./CORE/system_stm32f4xx.c ****   /* Configure the System clock source, PLL Multiplier and Divider factors, 
 443:./CORE/system_stm32f4xx.c ****      AHB/APBx prescalers and Flash settings ----------------------------------*/
 444:./CORE/system_stm32f4xx.c ****   SetSysClock();
 445:./CORE/system_stm32f4xx.c **** 
 446:./CORE/system_stm32f4xx.c ****   /* Configure the Vector Table location add offset address ------------------*/
 447:./CORE/system_stm32f4xx.c **** #ifdef VECT_TAB_SRAM
 448:./CORE/system_stm32f4xx.c ****   SCB->VTOR = SRAM_BASE | VECT_TAB_OFFSET; /* Vector Table Relocation in Internal SRAM */
 449:./CORE/system_stm32f4xx.c **** #else
 450:./CORE/system_stm32f4xx.c ****   SCB->VTOR = FLASH_BASE | VECT_TAB_OFFSET; /* Vector Table Relocation in Internal FLASH */
 451:./CORE/system_stm32f4xx.c **** #endif
 452:./CORE/system_stm32f4xx.c **** }
