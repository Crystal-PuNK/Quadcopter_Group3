  46:./User/Delay.c **** // /**
  47:./User/Delay.c **** //  * @brief 初始化延迟函数
  48:./User/Delay.c **** //  * 当使用OS的时候,此函数会初始化OS的时钟节拍
  49:./User/Delay.c **** //  * SYSTICK的时钟固定为AHB时钟的1/8
  50:./User/Delay.c **** //  * SYSCLK:系统时钟频率
  51:./User/Delay.c **** //  * @param SYSCLK 
  52:./User/Delay.c **** //  */
  53:./User/Delay.c **** // void SysTick_Init(u8 SYSCLK) {
  54:./User/Delay.c **** //     u32 reload;
  55:./User/Delay.c **** //     SysTick_CLKSourceConfig(SysTick_CLKSource_HCLK_Div8);
  56:./User/Delay.c **** //     reload = SYSCLK / 8;                   //每秒钟的计数次数 单位为M
  57:./User/Delay.c **** //     reload *= 1000000 / OS_TICKS_PER_SEC;  //根据OS_TICKS_PER_SEC设定溢出时间
  58:./User/Delay.c **** //                                            // reload为24位寄存器,最大值:16777216
  59:./User/Delay.c **** //     SysTick->CTRL |= SysTick_CTRL_TICKINT_Msk;  //开启SYSTICK中断
  60:./User/Delay.c **** //     SysTick->LOAD = reload;  //每1/OS_TICKS_PER_SEC秒中断一次
  61:./User/Delay.c **** //     SysTick->CTRL |= SysTick_CTRL_ENABLE_Msk;  //开启SYSTICK
  62:./User/Delay.c **** // }
