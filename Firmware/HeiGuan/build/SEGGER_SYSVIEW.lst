 179:./SystemView/SEGGER_SYSVIEW.c **** **********************************************************************
 180:./SystemView/SEGGER_SYSVIEW.c **** */
 181:./SystemView/SEGGER_SYSVIEW.c **** // Timestamps may be less than full 32-bits, in which case we need to zero
 182:./SystemView/SEGGER_SYSVIEW.c **** // the unused bits to properly handle overflows.
 183:./SystemView/SEGGER_SYSVIEW.c **** // Note that this is a quite common scenario, as a 32-bit time such as
 184:./SystemView/SEGGER_SYSVIEW.c **** // SysTick might be scaled down to reduce bandwith
 185:./SystemView/SEGGER_SYSVIEW.c **** // or a 16-bit hardware time might be used.
 186:./SystemView/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_TIMESTAMP_BITS < 32  // Eliminate unused bits in case hardware timestamps are le
 187:./SystemView/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta) Delta <<= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS; \
 188:./SystemView/SEGGER_SYSVIEW.c ****                                   Delta >>= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS;
 189:./SystemView/SEGGER_SYSVIEW.c **** #else
 190:./SystemView/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta)
 191:./SystemView/SEGGER_SYSVIEW.c **** #endif
 192:./SystemView/SEGGER_SYSVIEW.c **** 
 193:./SystemView/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_SUPPORT_LONG_ID
 194:./SystemView/SEGGER_SYSVIEW.c ****   #define _MAX_ID_BYTES       5u
 195:./SystemView/SEGGER_SYSVIEW.c **** #else
 196:./SystemView/SEGGER_SYSVIEW.c ****   #define _MAX_ID_BYTES       2u
 197:./SystemView/SEGGER_SYSVIEW.c **** #endif
 198:./SystemView/SEGGER_SYSVIEW.c **** 
 199:./SystemView/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_SUPPORT_LONG_DATA
 200:./SystemView/SEGGER_SYSVIEW.c ****   #define _MAX_DATA_BYTES     5u
 201:./SystemView/SEGGER_SYSVIEW.c **** #else
 202:./SystemView/SEGGER_SYSVIEW.c ****   #define _MAX_DATA_BYTES     2u
 203:./SystemView/SEGGER_SYSVIEW.c **** #endif
 204:./SystemView/SEGGER_SYSVIEW.c **** 
 205:./SystemView/SEGGER_SYSVIEW.c **** /*********************************************************************
 206:./SystemView/SEGGER_SYSVIEW.c **** *
 207:./SystemView/SEGGER_SYSVIEW.c **** *       Defines, fixed
ARM GAS  /var/folders/yl/_q9l42k90g1g4mdhbs226msm0000gn/T//ccxj18A8.s 			page 6


 208:./SystemView/SEGGER_SYSVIEW.c **** *
 209:./SystemView/SEGGER_SYSVIEW.c **** **********************************************************************
 210:./SystemView/SEGGER_SYSVIEW.c **** */
 211:./SystemView/SEGGER_SYSVIEW.c **** #define ENABLE_STATE_OFF        0
 212:./SystemView/SEGGER_SYSVIEW.c **** #define ENABLE_STATE_ON         1
 213:./SystemView/SEGGER_SYSVIEW.c **** #define ENABLE_STATE_DROPPING   2
 214:./SystemView/SEGGER_SYSVIEW.c **** 
