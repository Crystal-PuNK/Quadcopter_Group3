 232:./SystemView/SEGGER_SYSVIEW.c ****   U32       Options;
 233:./SystemView/SEGGER_SYSVIEW.c ****   unsigned  Cnt;
 234:./SystemView/SEGGER_SYSVIEW.c **** } SEGGER_SYSVIEW_PRINTF_DESC;
 235:./SystemView/SEGGER_SYSVIEW.c **** 
 236:./SystemView/SEGGER_SYSVIEW.c **** typedef struct {
 237:./SystemView/SEGGER_SYSVIEW.c ****         U8                      EnableState;   // 0: Disabled, 1: Enabled, (2: Dropping)
 238:./SystemView/SEGGER_SYSVIEW.c ****         U8                      UpChannel;
 239:./SystemView/SEGGER_SYSVIEW.c ****         U8                      RecursionCnt;
 240:./SystemView/SEGGER_SYSVIEW.c ****         U32                     SysFreq;
 241:./SystemView/SEGGER_SYSVIEW.c ****         U32                     CPUFreq;
 242:./SystemView/SEGGER_SYSVIEW.c ****         U32                     LastTxTimeStamp;
 243:./SystemView/SEGGER_SYSVIEW.c ****         U32                     RAMBaseAddress;
 244:./SystemView/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE == 1)
 245:./SystemView/SEGGER_SYSVIEW.c ****         U32                     PacketCount;
 246:./SystemView/SEGGER_SYSVIEW.c **** #else
 247:./SystemView/SEGGER_SYSVIEW.c ****         U32                     DropCount;
 248:./SystemView/SEGGER_SYSVIEW.c ****         U8                      DownChannel;
 249:./SystemView/SEGGER_SYSVIEW.c **** #endif
